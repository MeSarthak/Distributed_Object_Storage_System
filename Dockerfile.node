# Stage 1: Build binary
FROM golang:1.24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/storage-node ./cmd/storage-node

# Stage 2: Minimal runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata curl

WORKDIR /app

COPY --from=builder /bin/storage-node /app/storage-node

# Create persistent chunks directory
RUN mkdir -p /data/chunks

VOLUME ["/data/chunks"]

EXPOSE 9001

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:9001/health || exit 1

ENTRYPOINT ["/app/storage-node"]
