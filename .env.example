# ==============================================================================
# Distributed Object Storage System - Environment Configuration
# ==============================================================================

# --- Coordinator Settings ---
COORDINATOR_PORT=8080
COORDINATOR_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# --- Database Connection ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=storage_user
DB_PASSWORD=storage_secret
DB_NAME=storage_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# --- Authentication & Security ---
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24
BCRYPT_COST=12

# --- Placement Engine Weights (Must sum to 1.0) ---
WEIGHT_STORAGE=0.35
WEIGHT_CPU=0.20
WEIGHT_RAM=0.15
WEIGHT_LATENCY=0.15
WEIGHT_HEALTH=0.15

# Placement Exclusion Thresholds
MAX_CPU_THRESHOLD=90.0
MAX_RAM_THRESHOLD=90.0
MIN_FREE_STORAGE_BYTES=104857600 # 100MB minimum free space required

# --- Replication Policies ---
DEFAULT_REPLICATION_FACTOR=3
MIN_REPLICATION_FACTOR=2
MAX_REPLICATION_FACTOR=5

# Access frequency thresholds for adaptive replication (accesses in last 24h)
HOT_ACCESS_THRESHOLD=50
COLD_ACCESS_THRESHOLD=5

# --- Failure Detection & Heartbeat ---
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=15
SELF_HEALING_INTERVAL_SECONDS=10

# --- Storage Node Configuration (For individual storage node instances) ---
NODE_ID=
NODE_HOSTNAME=storage-node-1
NODE_PORT=9001
NODE_STORAGE_PATH=/data/chunks
NODE_CAPACITY_BYTES=10737418240 # 10GB default simulated capacity
NODE_COORDINATOR_URL=http://coordinator:8080
